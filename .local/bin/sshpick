#!/bin/bash
USAGE="Usage: $0 [ --help,-h | --ip,-i <hostname> | --user,-u <hostname> | --port,-p <hostname> ] [ <query> ]"
RED='\033[1;31m'
NC='\033[0m' # No Color

main() {
    local command="$1"
    if [ "$command" == "--help" ] || [ "$command" == "-h" ]; then
        echo "Utility to quickly retrieve SSH host information from ~/.ssh/config"
        echo "$USAGE"
        exit 0
    fi

    check_dependencies
    case "$command" in
        "--ip" | "-i")
            local host
            host="${2:-$(choose_host)}"
            get_host_ip "$host"
            ;;
        "--user" | "-u")
            local host
            host="${2:-$(choose_host)}"
            get_host_user "$host"
            ;;
        "--port" | "-p")
            local host
            host="${2:-$(choose_host)}"
            get_host_port "$host"
            ;;
        "--control-path" | "-c")
            local host
            host="${2:-$(choose_host)}"
            get_host_control_path "$host"
            ;;
        "")
            choose_host
            ;;
        *)
            choose_host "$1"
            ;;
    esac
}

check_dependencies() {
    local dependencies=(ssh awk fzf find)
    for dep in "${dependencies[@]}"; do
        check_dep "$dep"
    done
}

check_dep() {
    local dep="$1"
    if ! command -v "$dep" &> /dev/null; then
        log_error "$dep is not installed. Please install $dep to use this script"
    fi
}

log_error() {
    echo -e "[${RED}ERROR${NC}] $*" >&2
    exit 1
}

has_tty() {
    [ -r /dev/tty ] && [ -w /dev/tty ]
}

choose_host() {
    local query="$1"
    if ! has_tty; then
        if [ -n "$query" ]; then
            echo "$query"
            return
        fi
        log_error "No TTY available for interactive host selection. Please provide a query or run in an interactive terminal"
    fi

    mapfile -t ssh_config < <(
        [ -f ~/.ssh/config ] && echo ~/.ssh/config
        [ -d ~/.ssh/config.d ] && find ~/.ssh/config.d -type f
    )
    if [ ${#ssh_config[@]} -eq 0 ]; then
        log_error "No SSH config files found in ~/.ssh/config or ~/.ssh/config.d/"
    fi

    local hosts
    hosts=$(
        awk '/^[[:space:]]*Host[[:space:]]+/ {
            for (i=2; i<=NF; i++)
                if ($i !~ /[*?]/ && $i != "*")
                    print $i
        }' "${ssh_config[@]}" 2>/dev/null | sort -u)

    if [ -z "$hosts" ]; then
        log_error "No hosts found in ~/.ssh/config"
    fi

    local query_flag
    if [ -n "$query" ]; then
        query_flag=("--query" "$query")
    else
        query_flag=()
    fi

    local fzf_preview_cmd
    fzf_preview_cmd=$(cat <<"EOF"
        host={}
        cfg=$(ssh -G "$host" 2>/dev/null)

        hostname=$(awk "/^hostname / {print \$2}" <<< "$cfg")
        port=$(awk "/^port / {print \$2}" <<< "$cfg")
        control=$(awk "/^controlpath / {print \$2}" <<< "$cfg")
        control_exists="no"
        [ -S "$control" ] && control_exists="yes"

        # Check if the host is reachable and get latency
        timeout_value=0.3
        timeout "$timeout_value" nc -z -w1 "$hostname" "$port" 2>/dev/null && reach=yes || reach=no
        lat=$(timeout "$timeout_value" ping -c1 "$hostname" 2>/dev/null | awk -F"time=" "/time=/{print \$2}" | cut -d" " -f1)
        lat=${lat:-"n/a"}

        # Check if the control socket exists
        [ -S "$control" ] && conn=yes || conn=no

        awk -v reach="$reach" -v lat="$lat" -v conn="$conn" -v control_exists="$control_exists" '
            BEGIN {
              c="\033[36m"; ok="\033[32m"; bad="\033[31m"; dim="\033[90m"; r="\033[0m"
            }

            /^user /        { user=$2 }
            /^hostname /    { host=$2 }
            /^port /        { port=$2 }
            /^controlpath / { control=$2 }

            END {
              printf "%sUser:%s            %s\n", c, r, user
              printf "%sHostname:%s        %s\n", c, r, host
              printf "%sPort:%s            %s\n", c, r, port

              printf "%sReachable (ssh):%s %s%s%s\n", c, r,
                     (reach=="yes" ? ok : bad),
                     (reach=="yes" ? "yes" : "no"),
                     r

              printf "%sLatency (ping):%s  %s ms\n", c, r,
                     (lat=="" ? "n/a" : lat)

              printf "%sConnected:%s       %s%s%s\n", c, r,
                     (conn=="yes" ? ok : dim),
                     (conn=="yes" ? "yes" : "no"),
                     r

              printf "%sControlPath:%s     %s%s%s\n", c, r,
                     (control_exists=="yes" ? "" : dim),
                     (control_exists=="yes" ? control : "n/a"),
                     r
            }
        ' <<< "$cfg"
EOF
    )

    local selected_host
    selected_host=$(
        echo "$hosts" | SHELL="bash" fzf \
            --height=24 \
            --prompt="Select a host: " \
            "${query_flag[@]}" \
            --preview="$fzf_preview_cmd" \
            --preview-window=up:7 \
            --preview-label="Host details" \
            --preview-label-pos=+3
    )
    # Admit hosts not found in the config if a query is provided just in case
    if [ -z "$selected_host" ]; then
        if [ -n "$query" ]; then
            selected_host="$query"
        else
            exit 1
        fi
    fi

    echo "$selected_host"
}

get_ssh_field() {
    local host="$1"
    local field="$2"
    local value
    value=$(ssh -G "$host" | awk -v field="$field" '$1 == field {print $2}')
    if [ -z "$value" ]; then
        log_error "Could not retrieve $field for host '$host'"
    fi
    echo "$value"
}

get_host_ip() {
    local host="$1"
    get_ssh_field "$host" "hostname"
}

get_host_user() {
    local host="$1"
    get_ssh_field "$host" "user"
}

get_host_port() {
    local host="$1"
    get_ssh_field "$host" "port"
}

get_host_control_path() {
    local host="$1"
    get_ssh_field "$host" "controlpath"
}

main "$@"
