#!/bin/bash
USAGE="Usage: $0 [ --ip,-i <hostname> | --user,-u <hostname> | --help,-h ] [ <query> ]"

main() {
    local command="$1"
    case "$command" in
        "--ip" | "-i")
            local host
            host="${2:-$(choose_host)}"
            get_host_ip "$host"
            ;;
        "--user" | "-u")
            local host
            host="${2:-$(choose_host)}"
            get_host_user "$host"
            ;;
        "-h" | "--help")
            echo "Utility to quickly retrieve SSH host information from ~/.ssh/config."
            echo "$USAGE"
            exit 0
            ;;
        "")
            choose_host
            ;;
        *)
            choose_host "$1"
            ;;
    esac
}

log_error() {
    echo "ERROR: $*" >&2
    exit 1
}

choose_host() {
    if ! command -v fzf &> /dev/null; then
        log_error "fzf is not installed. Please install fzf to use this script."
    fi

    local hosts
    hosts=$(
        awk '/^[[:space:]]*Host[[:space:]]+/ {
            for (i=2; i<=NF; i++)
                if ($i !~ /[*?]/ && $i != "*")
                    print $i
        }' ~/.ssh/config ~/.ssh/config.d/* 2>/dev/null | sort -u)

    if [ -z "$hosts" ]; then
        log_error "No hosts found in ~/.ssh/config."
    fi

    local query_flag
    if [ -n "$1" ]; then
        query_flag=("--query" "$1")
    else
        query_flag=()
    fi

    local selected_host
    selected_host=$(
        echo "$hosts" | fzf \
            --prompt="Select a host: " \
            "${query_flag[@]}" \
            --preview="ssh -G {} 2>/dev/null | awk '/^hostname / {print \"IP: \" \$2} /^user / {print \"User: \" \$2} /^port / {print \"Port: \" \$2}'" \
            --preview-window=up:3:wrap
        )
    if [ -z "$selected_host" ]; then
        log_error "No host selected."
    fi

    echo "$selected_host"
}

get_host_ip() {
    local host="$1"
    local ip
    ip=$(ssh -G "$host" | awk '/^hostname / {print $2}')
    if [ -z "$ip" ]; then
        log_error "Could not retrieve IP for host '$host'."
    fi
    echo "$ip"
}

get_host_user() {
    local host="$1"
    local user
    user=$(ssh -G "$host" | awk '/^user / {print $2}')
    if [ -z "$user" ]; then
        log_error "Could not retrieve user for host '$host'."
    fi
    echo "$user"
}

main "$@"
