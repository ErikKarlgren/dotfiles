#!/usr/bin/env python3
import argparse
import subprocess


def main():
    args = parse_args()
    mode: str = args.mode

    if mode == "both-screens":
        kscreen_doctor(enable_laptop_screen=True, enable_external_screen=True)
    elif mode == "only-laptop":
        kscreen_doctor(enable_laptop_screen=True, enable_external_screen=False)
    elif mode == "only-external":
        kscreen_doctor(enable_laptop_screen=False, enable_external_screen=True)


def parse_args():
    parser = argparse.ArgumentParser(
        description="Set a display configuration for KDE using kscreen-doctor. Meant for my Acer Aspire laptop."
    )
    parser.add_argument(
        "mode", choices=["both-screens", "only-laptop", "only-external"]
    )
    return parser.parse_args()


def kscreen_doctor(enable_laptop_screen: bool, enable_external_screen: bool):
    assert enable_laptop_screen or enable_external_screen

    # Hardcoded values because this is my setup for my Acer Aspire laptop
    laptop_screen_name = "eDP-1"
    laptop_screen_width_px = 1280
    external_screen_name = "HDMI-A-1"

    def to_string(val: bool):
        if val:
            return "enable"
        else:
            return "disable"

    subprocess.run(
        [
            "kscreen-doctor",
            f"output.{laptop_screen_name}.{to_string(enable_laptop_screen)}",
            f"output.{external_screen_name}.{to_string(enable_external_screen)}",
            # The following makes the external screen be to the right of the laptop's screen
            f"output.{external_screen_name}.position.{laptop_screen_width_px},0",
        ]
    )


if __name__ == "__main__":
    main()
