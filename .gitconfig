[user]
	email = erik.karldom@gmail.com
	name = Erik Karlgren Domercq

[alias]
	a = add
	br = branch
	ca = commit --amend
	can = commit --amend --no-edit
	ch = checkout
	co = commit
	coi = commit --interactive
	cp = cherry-pick
	pf = push --force-with-lease
	ps = push
	rc = rebase --continue
	re = rebase
	ri = rebase -i
	s = status -s
	sw = switch
	swc = switch -c
	wk = worktree

	# From https://jordanelver.co.uk/blog/2020/06/04/fixing-commits-with-git-commit-fixup-and-git-rebase-autosquash/
	fixup = "!git log -n 50 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup"

[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[core]
	editor = nvim

	# Use git-delta as pager
	pager = delta

	# Speed up commands involving untracked files such as `git status`.
	# https://git-scm.com/docs/git-update-index#_untracked_cache
	untrackedCache = true

[delta]
	navigate = true    # use n and N to move between diff sections
	syntax-theme = base16
	line-numbers = true
	line-numbers-plus-style = green auto
	line-numbers-minus-style = red auto

[diff]
	# Detect copies as well as renames
	renames = copies
	colorMoved = true
	algorithm = histogram
[diff "bin"]
	# Use `hexdump` to diff binary files.
	textconv = hexdump -v -C

[fetch]
	prune = true

[help]
	# Automatically correct and execute mistyped commands.
	autocorrect = 1

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictstyle = diff3

[push]
	# Make `git push` push relevant annotated tags when pushing branches out.
	followTags = true

[rerere]
	enabled = true
